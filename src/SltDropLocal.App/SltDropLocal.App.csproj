<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SltDropLocal.App</RootNamespace>
    <AssemblyName>SLTDropLocalQRCode</AssemblyName>
    <AssemblyTitle>SLT Drop Local QRCode</AssemblyTitle>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Publicação para o instalador: um único .exe autocontido, com o runtime do
       .NET, o Windows Forms, o ASP.NET Core (Kestrel) e o QRCoder dentro. Quem
       instala não precisa ter nada instalado antes. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SltDropLocal.Core\SltDropLocal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\icon.ico" LogicalName="SltDropLocal.icon.ico" />
  </ItemGroup>

</Project>
